rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // As carreiras salvas de um jogador.
    //
    // Duas garantias moram aqui, e nao no cliente: so o dono le e escreve as
    // proprias carreiras, e as vagas sao exatamente tres. Como o id do
    // documento **e** a vaga, limitar os ids a '1', '2' e '3' e o que impede
    // uma quarta carreira mesmo vinda de um cliente adulterado.
    match /usuarios/{uid}/carreiras/{vaga} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && vaga in ['1', '2', '3']
        && request.resource.data.state is string
        && request.resource.data.state.size() < 1000000;
    }

    // Nada mais e acessivel pelo cliente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
